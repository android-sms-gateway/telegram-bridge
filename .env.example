# Environment Configuration Template for telegram-bridge
# Copy this file to .env and fill in your actual values.
# This file contains all required environment variables with examples and documentation.
#
# Loading order (later sources override earlier ones):
#   1. Optional YAML file, path taken from CONFIG_PATH.
#   2. .env file in the working directory (same KEY__SUBKEY format).
#   3. Real environment variables of the running process.
#
# Key semantics (go-core-fx/config over koanf):
#   - No prefix: keys are read from the environment as-is, without a service prefix.
#   - "__" separates nesting levels: HTTP__OPENAPI__ENABLED -> http.openapi.enabled.
#   - Key case is normalized to lowercase, so the mapping is case-insensitive.

# =============================================================================
# CONFIGURATION LOADING
# =============================================================================

# Optional YAML configuration file path
# Purpose: Points config.New at a YAML file whose keys use the same nesting as the
#   environment variables. The file is loaded before the .env values are applied.
#   Leave it empty to run from environment variables only.
# Format: File path
# Default: empty (environment only)
# Example: config.yml
# Example: configs/telegram-bridge.yml
# CONFIG_PATH=config.yml

# =============================================================================
# HTTP SERVER
# =============================================================================

# HTTP listen address
# Purpose: Address the Fiber server binds to (fiberfx.Config.Address). It hosts the
#   health endpoint, Prometheus metrics, the OpenAPI docs UI and the SMSGate webhook
#   at POST /api/v1/webhook. Keep 127.0.0.1 when running behind a reverse proxy.
# Format: host:port
# Default: 127.0.0.1:3000
# Example: 0.0.0.0:3000
HTTP__ADDRESS=127.0.0.1:3000

# Trusted proxy client IP header
# Purpose: Header the server reads to resolve the real client IP
#   (fiberfx.Config.ProxyHeader) when running behind a reverse proxy. Only meaningful
#   together with HTTP__PROXIES.
# Format: Header name
# Default: X-Forwarded-For
# Example: X-Forwarded-For
# Example: X-Real-IP
# HTTP__PROXY_HEADER=X-Forwarded-For

# Trusted proxy IP addresses
# Purpose: List of proxy IPs whose forwarded headers are trusted (fiberfx.Config.Proxies).
#   Empty means no proxy is trusted, so any forwarded header is ignored.
# Format: JSON array of IP addresses
# Default: [] (no trusted proxies)
# Example: ["10.0.0.1"]
# Example: ["10.0.0.1","10.0.0.2"]
# HTTP__PROXIES=["10.0.0.1"]

# =============================================================================
# HTTP OPENAPI
# =============================================================================

# OpenAPI docs UI enabled
# Purpose: Serves the Swagger UI and the generated OpenAPI document under
#   /api/v1/docs (openapi.Config.Enabled). Turn it off on public deployments to avoid
#   exposing the API surface.
# Format: Boolean (true|false)
# Default: true
# Example: false
# HTTP__OPENAPI__ENABLED=true

# Public host advertised in the docs UI
# Purpose: Host written into the OpenAPI server definition rendered by the docs UI.
#   Empty means the host is inferred from the incoming request.
# Format: Host name, without scheme
# Default: empty (inferred from the incoming request)
# Example: api.example.com
# HTTP__OPENAPI__PUBLIC_HOST=

# Public path advertised in the docs UI
# Purpose: Base path written into the OpenAPI server definition rendered by the docs UI.
#   Empty means the path is inferred from the incoming request.
# Format: URL path, without trailing slash
# Default: empty (inferred from the incoming request)
# Example: /api/v1
# HTTP__OPENAPI__PUBLIC_PATH=

# =============================================================================
# TELEGRAM BOT (telegofx infrastructure)
# =============================================================================
# Consumed by internal/config as the telegram section and handed to telegofx
# unchanged as telegofx.Config. Where a forwarded message is delivered is not a
# Telegram client setting: it lives in the BRIDGE section below.

# Telegram bot token
# Purpose: Token issued by @BotFather and passed to telegofx. The bot cannot start
#   without it. Treat it as a secret and never commit the real value.
# Format: Token string obtained from @BotFather
# Default: empty (required, the bot fails to start without it)
# Example: your-bot-token
TELEGRAM__TOKEN=

# Telegram API SOCKS5 proxy
# Purpose: SOCKS5 dialer used for all Telegram API traffic (telegofx.Config.ProxyURL).
#   telegofx accepts only socks5:// and socks5h://; socks5h:// resolves hostnames through
#   the proxy. Any other scheme, including http:// and https://, is rejected when the bot
#   is created and the service fails to start. Empty means a direct connection.
# Format: SOCKS5 URL (socks5://host:port or socks5h://user:password@host:port)
# Default: empty (direct connection)
# Example: socks5://127.0.0.1:1080
# Example: socks5h://user:password@127.0.0.1:1080
# TELEGRAM__PROXY_URL=socks5://127.0.0.1:1080

# =============================================================================
# BRIDGE (forward target)
# =============================================================================
# Consumed by internal/config as the bridge section and handed to internal/bridge
# as bridge.Config.

# Forward target chat id
# Purpose: Numeric chat id that receives messages forwarded from SMSGate
#   (bridge.Config.ChatID). This is the bridge forward target, not a Telegram
#   client setting: it moved here from the former telegram section, where the key
#   was TELEGRAM__CHAT_ID. That old key is now inert.
#   Zero means "not configured": forwarding then fails with bridge.ErrNoChatID
#   instead of sending to an unknown chat.
# Format: Integer
# Default: 0 (not configured)
# Example: 123456789
# Example: -1001234567890
# BRIDGE__CHAT_ID=123456789

# =============================================================================
# SMSGATE SERVER API
# =============================================================================

# SMSGate server base URL
# Purpose: Base URL of the SMSGate server REST API used by the reply path
#   (smsgate.base_url). Declared for a later wave; not consumed by the running service yet.
# Format: URL without trailing slash
# Default: empty
# Example: https://api.example.com
# SMSGATE__BASE_URL=

# SMSGate API username
# Purpose: Basic-auth user for the SMSGate REST API reply path (smsgate.username).
#   Declared for a later wave; not consumed by the running service yet.
# Format: String
# Default: empty
# Example: change-me
# SMSGATE__USERNAME=

# SMSGate API password
# Purpose: Basic-auth password for the SMSGate REST API reply path (smsgate.password).
#   Declared for a later wave; not consumed by the running service yet.
# Format: String
# Default: empty
# Example: change-me
# SMSGATE__PASSWORD=

# =============================================================================
# SMSGATE WEBHOOK
# =============================================================================

# SMSGate webhook signing key
# Purpose: Shared secret that authenticates inbound SMSGate webhook deliveries on
#   POST /api/v1/webhook (webhook.Config.SigningKey). It must match the signing key set
#   on the device under Settings -> Webhooks -> Signing Key. A request is authenticated by
#   an HMAC-SHA256 signature over the raw body plus the X-Timestamp header, hex encoded in
#   X-Signature. The X-Timestamp must be within 5 minutes of the server clock (requests
#   outside that window are rejected to stop replays). An empty key is fail-closed: every
#   request is answered with 401.
# Format: String
# Default: empty (fail-closed, all webhook requests return 401)
# Example: change-me
SMSGATE__WEBHOOK__SIGNING_KEY=

# =============================================================================
# STORAGE
# =============================================================================

# Embedded bbolt database URL
# Purpose: URL of the embedded bbolt database (storage.url) that holds bridge state.
#   Declared for a later wave; not consumed by the running service yet.
# Format: bolt://<file path>
# Default: bolt://data/telegram-bridge.db
# Example: bolt://data/telegram-bridge.db
# STORAGE__URL=bolt://data/telegram-bridge.db
