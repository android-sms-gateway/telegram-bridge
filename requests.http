###
GET {{baseURL}}/health HTTP/1.1

###
GET {{baseURL}}/health/live HTTP/1.1

###
GET {{baseURL}}/health/ready HTTP/1.1

###
GET {{baseURL}}/health/startup HTTP/1.1

###
GET {{baseURL}}/metrics HTTP/1.1

# ============================================================
# 2. WEBHOOK (SMSGate -> Telegram bridge)
# ============================================================

# Forward a received SMS to the configured Telegram chat.
#
# Auth = SMSGate payload signing (docs.sms-gate.app, Webhooks -> Payload
# Signing): X-Signature is the hex HMAC-SHA256 of the raw request body
# followed by the X-Timestamp value (unix seconds), keyed with the device
# signing key (SMSGATE__WEBHOOK__SIGNING_KEY here).
#
# Regenerating @signature for the fixed sample body below:
#
#   1. Save the exact JSON body (everything after the blank line in this
#      request) to a file, e.g. webhook-body.json, with NO trailing newline.
#   2. Compute:
#
#        printf '%s' "$(cat webhook-body.json)1700000000" \
#          | openssl dgst -sha256 -hmac "change-me" \
#          | awk '{print $NF}'
#
#   3. Paste the hex digest into @signature above and 1700000000 into
#      @timestamp (they must match: signature is computed over body+timestamp).
#
# An empty SMSGATE__WEBHOOK__SIGNING_KEY rejects every request with 401. The
# body matches the SMSGate app webhook envelope (event sms:received); only
# payload.sender (or the deprecated payload.phoneNumber) and payload.message
# are read today.

###
POST {{baseURL}}/api/v1/webhook HTTP/1.1
X-Signature: {{signature}}
X-Timestamp: {{timestamp}}
Content-Type: application/json

{
  "id": "Ey6ECgOkVVFjz3CL48B8C",
  "webhookId": "LreFUt-Z3sSq0JufY9uWB",
  "event": "sms:received",
  "deviceId": "ffffffffceb0b1db0000018e937c815b",
  "payload": {
    "messageId": "abc123",
    "sender": "6505551212",
    "recipient": "+1234567890",
    "simNumber": 1,
    "phoneNumber": "6505551212",
    "message": "Android is always a sweet treat!",
    "receivedAt": "2024-06-22T15:46:11.000+07:00"
  }
}
